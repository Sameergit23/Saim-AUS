# ---- Saim-AUS example configuration ----
# Copy to .env and fill in real values. NEVER commit your real .env.

# Server
NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# Storage backend: "memory" (dev/tests, no DB) or "postgres"
STORAGE=memory

# PostgreSQL (required when STORAGE=postgres)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/saim_aus

# JWT signing secret for access tokens (HS256).
# Generate a strong random value, e.g.:  openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret-string-at-least-32-chars
JWT_KID=key-2026-09

# Token lifetimes
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
EMAIL_TOKEN_TTL_MINUTES=60

# Cookies
COOKIE_SECURE=false        # set true in production (HTTPS)
COOKIE_DOMAIN=

# Public base URL used to build email links
PUBLIC_BASE_URL=http://localhost:3000
